<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- 品牌名与包标识：不随界面语言变化，故 translatable="false" 且不在 values-zh 重复。
         默认资源必须是英文——Android 的资源兜底规则是「系统语言匹配不到任何
         语言限定符目录时用默认资源」，若默认放中文，英文/日文/德文系统都会看到中文。 -->
    <string name="app_name" translatable="false">Aurora Music</string>
    <string name="title_activity_main" translatable="false">Aurora Music</string>
    <string name="package_name" translatable="false">com.aurora.music</string>
    <string name="custom_url_scheme" translatable="false">com.aurora.music</string>

    <!-- 应用自有文案：统一 aurora_ 前缀，与 Capacitor 框架字符串（app_name /
         title_activity_main / package_name / custom_url_scheme）隔开，
         避免上游模板升级时被覆盖或误改。
         所有值均整句给出，不拼接：中文见 values-zh/strings.xml。 -->
    <string name="aurora_notification_channel_name">Music playback</string>
    <string name="aurora_notification_channel_description">Aurora Music media playback controls</string>
    <string name="aurora_notification_action_previous">Previous</string>
    <string name="aurora_notification_action_play">Play</string>
    <string name="aurora_notification_action_pause">Pause</string>
    <string name="aurora_notification_action_next">Next</string>

    <!-- 局域网同步前台服务（LanSyncService）：通知渠道与常驻通知文案。
         「Listening on port %1$d」里的占位符是端口号，由服务在真实端口确定后填入。 -->
    <string name="aurora_lan_sync_channel_name">LAN sync</string>
    <string name="aurora_lan_sync_channel_description">Keeps the phone reachable to paired devices on the same network</string>
    <string name="aurora_lan_sync_notification_title">LAN sync</string>
    <string name="aurora_lan_sync_notification_text">Listening on port %1$d</string>
    <string name="aurora_lan_sync_notification_text_starting">Starting…</string>
</resources>
