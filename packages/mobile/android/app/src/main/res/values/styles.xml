<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      运行时主题。系统栏配色必须写在这里，不能只靠 Web 侧 StatusBar 插件：
        · 导航栏（navigationBarColor）在 Capacitor 里没有任何插件接口，
          只能在主题层给值；
        · 状态栏在 Android 15+ 强制 edge-to-edge 后 setBackgroundColor 被系统
          忽略，主题值就是唯一可预期的来源。
      windowLight* 的含义是「系统栏图标用深色」（即浅色背景），app 是深色底，
      故两者都取 false，让系统绘制浅色图标。
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/aurora_window_bg</item>
        <item name="android:statusBarColor">@color/aurora_window_bg</item>
        <item name="android:navigationBarColor">@color/aurora_window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
      启动主题。启动链路上的每一层都要显式给值，不能吃库/系统的默认值：

        1. android:background —— 冷启动的窗口背景，也就是 @capacitor/splash-screen
           按名字找的那张 splash（插件默认 androidSplashResourceName = "splash"）。
           它现在是 res/drawable/splash.xml 的 layer-list，**只有纯色底、不画图形**；
           底色取 colors.xml 的 aurora_window_bg，不写死色值。
        2. windowSplashScreenBackground —— 启动画面底色（API < 31 的兼容路径与
           API >= 31 的系统路径都读它）。不显式给值时取主题的 colorBackground，
           浅色系统主题下会先闪一帧白底。
        3. postSplashScreenTheme —— 缺失时 core-splashscreen 无法把窗口切回运行时
           主题，系统栏会一直停留在启动主题的默认样式上（真机实测：状态栏 #757575
           灰、导航栏 #FAFAFA 白，与深色播放器割裂）。
        4. windowSplashScreenAnimatedIcon —— 必须显式给值，且给的是
           @drawable/splash_blank（全透明）：

           · 不写 = 吃库默认的 @android:drawable/sym_def_app_icon（系统那个通用机器人
             图标）；给应用图标 = 白送系统去画它——Android 12+ 的系统启动画面会把图标
             按「画布 × 1.5」放大再套设备图标形状遮罩，我们的满幅前景会变成一块放大、
             四角发尖的数码方块（真机实拍）。
           · 开屏不放品牌图形是刻意的：要在系统路径里放图形，就得长期维护一套 288dp
             画布（图形占中间 2/3）的派生资源，还得兼顾 API < 31 的另一套尺寸口径。
             不值为了一块开屏图形付这份维护成本，见 drawable/splash.xml 的注释。
           · values-v31/styles.xml 里再显式写一次平台属性，是为了不依赖「库会把自定义
             属性透传成平台属性」这层间接关系。
    -->
    <style name="AppTheme.NoActionBarLaunchBase" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/aurora_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- values-v31/styles.xml 在 API >= 31 上覆盖同名主题（补系统启动画面属性） -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBarLaunchBase" />
</resources>
