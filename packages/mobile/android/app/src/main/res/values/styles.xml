<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      运行时主题。系统栏配色必须写在这里，不能只靠 Web 侧 StatusBar 插件：
        · 导航栏（navigationBarColor）在 Capacitor 里没有任何插件接口，
          只能在主题层给值；
        · 状态栏在 Android 15+ 强制 edge-to-edge 后 setBackgroundColor 被系统
          忽略，主题值就是唯一可预期的来源。
      windowLight* 的含义是「系统栏图标用深色」（即浅色背景），app 是深色底，
      故两者都取 false，让系统绘制浅色图标。
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/aurora_window_bg</item>
        <item name="android:statusBarColor">@color/aurora_window_bg</item>
        <item name="android:navigationBarColor">@color/aurora_window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
      启动主题。启动链路上的每一层都要显式给值，不能吃库/系统的默认值：

        1. android:background —— 冷启动的窗口背景，也就是 @capacitor/splash-screen
           按名字找的那张 splash（插件默认 androidSplashResourceName = "splash"）。
           它现在是 res/drawable/splash.xml 的 layer-list（纯色底 + 居中正方形图形），
           不再是整屏位图：整屏 png 会被按窗口尺寸拉伸（插件给 ImageView 的 ScaleType
           默认是 FIT_XY），位图宽高比固定（10:16）而车机屏竖屏实测 0.69、10 寸车机
           常见 800x1280 与 1280x800 —— 图里的牌子就被横着拉宽约 1.3 倍。layer-list
           两层各按自己的规则画（底色铺满、图形按自身像素居中），与屏幕宽高比无关。
           底色取 colors.xml 的 aurora_window_bg，不写死色值。
        2. windowSplashScreenBackground —— AndroidX core-splashscreen 的启动画面
           底色（API < 31 的兼容路径与 API >= 31 的系统路径都读它）。不显式给值时
           取主题的 colorBackground，浅色系统主题下会先闪一帧白底。
        3. postSplashScreenTheme —— 缺失时 core-splashscreen 无法把窗口切回运行时
           主题，系统栏会一直停留在启动主题的默认样式上（真机实测：状态栏 #757575
           灰、导航栏 #FAFAFA 白，与深色播放器割裂）。
        4. windowSplashScreenAnimatedIcon —— 必须显式给 @mipmap/ic_launcher：
           Theme.SplashScreen 的库默认值是 @android:drawable/sym_def_app_icon（系统
           那个通用机器人图标），不覆盖的话 API < 31 的兼容路径会拿它当启动图标。
           API >= 31 上库把本属性透传给系统的 android:windowSplashScreenAnimatedIcon，
           所以给了之后系统路径仍然是应用图标（自适应图标，系统按圆遮罩）。
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/aurora_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
