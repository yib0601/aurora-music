<?xml version="1.0" encoding="utf-8"?>
<!--
  启动画面的窗口背景（values/styles.xml 里 AppTheme.NoActionBarLaunch 的
  android:background），也是 @capacitor/splash-screen 按名字找的那张 splash。

  为什么是 layer-list、不是一张整屏 png：整屏位图宽高比固定（10:16），而它是被按
  窗口尺寸铺上去的（插件 Dialog 里的 ImageView 是 FIT_XY、starting window 也铺满），
  车机屏宽高比却五花八门——竖屏实测 0.69、10 寸车机常见 800x1280(0.625) 与
  1280x800 横屏——于是图里的牌子跟着被横着拉宽约 1.3 倍（2026-11 车机实拍：图形
  280x208，本该 1:1 正方形）。

  layer-list 两层各按自己的规则画：底色铺满、图形按自身像素居中
  （<bitmap android:gravity="center"> 不参与缩放），开屏在任何宽高比的屏上都只剩
  「余白多寡」的差别，图形永远不变形。

  图形文件由 scripts/generate-icons.sh 生成，别手改 drawable-*/splash_logo.png。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 与 values/colors.xml 的 aurora_window_bg 同源，不写死色值 -->
    <item android:drawable="@color/aurora_window_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
