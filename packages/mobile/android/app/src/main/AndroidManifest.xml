<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 媒体后台播放：Honor/Huawei AudioHardening 要求 app 声明 foreground service
         才会把 STREAM_MUSIC 路由到扬声器而非 remote_submix（否则被静音） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ 通知栏媒体控件需要运行时申请 POST_NOTIFICATIONS -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：调起系统安装器安装下载好的 APK。
         Android 8.0+ 还需用户在「安装未知应用」中为本应用单独授权（UpdatePlugin 负责引导） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 系统 DownloadManager 下载更新包（后台进行，App 被杀也不中断） -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- 局域网同步（LanSyncService，docs/playlist-sync.md §7/§17）：
         - DATA_SYNC：服务类型是「数据同步」，不是媒体播放；Android 14+ 必须与
           foregroundServiceType="dataSync" 成对声明，否则 startForeground 抛 SecurityException
         - ACCESS_WIFI_STATE + CHANGE_WIFI_MULTICAST_STATE：UDP 广播发现需要
           WifiManager.MulticastLock 关掉 Wi-Fi 驱动的广播过滤（见 LanSyncDiscovery 注释）
         - ACCESS_NETWORK_STATE：广播地址按网卡枚举时读网络状态，避免在无网时反复重试 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- MediaSession foreground service：保持音频焦点与 STREAM_MUSIC 路由到扬声器 -->
        <service
            android:name=".MediaPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- 局域网同步的前台服务：保持 HTTP 监听与 UDP 广播在息屏/切后台时仍可达。
             不导出：只有本应用能启停它（对端是走 TCP 进来的，不需要导出服务）。
             类型是 dataSync，不是 mediaPlayback（理由见 LanSyncService 类注释）。 -->
        <service
            android:name=".LanSyncService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
